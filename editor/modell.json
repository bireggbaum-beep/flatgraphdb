{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medizintechnik Fertigungsgraph Metamodell",
  "description": "Striktes JSON-Schema mit expliziten Beziehungspaaren (fromType -> relation -> toType). Referenz: datenmodell.pdf (22 Paare); Abweichung: Raum am Equipment statt an der Plant (Edge_Equipment_StehtIn_Raum).",
  "type": "object",
  "required": [
    "nodes",
    "edges"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/PlantNode"
          },
          {
            "$ref": "#/$defs/RoomNode"
          },
          {
            "$ref": "#/$defs/EquipmentNode"
          },
          {
            "$ref": "#/$defs/SoftwareNode"
          },
          {
            "$ref": "#/$defs/MediumNode"
          },
          {
            "$ref": "#/$defs/ProcessNode"
          },
          {
            "$ref": "#/$defs/ProcessstepNode"
          },
          {
            "$ref": "#/$defs/MaterialNode"
          },
          {
            "$ref": "#/$defs/DocumentNode"
          },
          {
            "$ref": "#/$defs/ParameterNode"
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "description": "Erlaubt NUR die exakt definierten 22 Beziehungspaare",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/Edge_Equipment_StehtIn_Raum"
          },
          {
            "$ref": "#/$defs/Edge_Plant_FuehrtAus_Prozess"
          },
          {
