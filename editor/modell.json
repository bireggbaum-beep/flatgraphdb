{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medizintechnik Fertigungsgraph Metamodell",
  "description": "JSON-Schema für Objekte, Relationen und Kanten-Attribute in der Produktion",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "description": "Liste aller Knoten (Objekte) im Produktionssystem",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/PlantNode" },
          { "$ref": "#/$defs/RoomNode" },
          { "$ref": "#/$defs/EquipmentNode" },
          { "$ref": "#/$defs/SoftwareNode" },
          { "$ref": "#/$defs/MediumNode" },
          { "$ref": "#/$defs/ProcessNode" },
          { "$ref": "#/$defs/ProcessstepNode" },
          { "$ref": "#/$defs/MaterialNode" },
          { "$ref": "#/$defs/DocumentNode" },
          { "$ref": "#/$defs/ParameterNode" }
        ]
      }
    },
    "edges": {
      "type": "array",
      "description": "Liste aller typisierten Kanten (Relationen) zwischen den Knoten",
      "items": {
        "$ref": "#/$defs/GraphEdge"
      }
    }
  },
  "$defs": {
    "PlantNode": {
      "type": "object",
      "required": ["id", "type", "properties"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "Plant" },
        "properties": {
          "type": "object",
          "required": ["PlantID", "PlantName", "PlantType", "PlantGXP"],
          "properties": {
            "PlantID": { "type": "string" },
            "PlantName": { "type": "string" },
            "PlantType": {
              "type": "string",
              "enum": ["Fertigungslinie", "Funktionsbereich (zB. Labor, QC)", "Einzelplatz"]
            },
            "PlantGXP": {
              "type": "string",
              "enum": ["GXP", "NGXP"]
            }
          }
        }
      }
    },
    "RoomNode": {
      "type": "object",
      "required": ["id", "type", "properties"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "Raum" },
        "properties": {
          "type": "object",
          "required": ["RoomID", "RoomName", "RoomClass"],
          "properties": {
            "RoomID": { "type": "string" },
            "RoomName": { "type": "string" },
            "RoomClass": {
              "type": "string",
              "enum": ["ISO 5", "ISO 6", "ISO 7", "ISO 8", "ISO 9"]
            }
          }
        }
      }
    },
    "EquipmentNode": {
      "type": "object",
      "required": ["id", "type", "properties"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "Equipment" },
        "properties": {
          "type": "object",
          "required": ["EquipmentID", "EquipmentName", "EquipmentGXP", "EquipmentCategory"],
          "properties": {
            "EquipmentID": { "type": "string" },
            "EquipmentName": { "type": "string" },
            "EquipmentGXP": {
              "type": "string",
              "enum": ["GXP", "NGXP"]
            },
            "EquipmentCategory": {
              "type": "string",
              "enum": ["Kat 1", "Kat 2", "Kat 3", "Kat 4"]
            }
          }
        }
      }
    },
    "SoftwareNode": {
      "type": "object",
      "required": ["id", "type", "properties"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "Software" },
        "properties": {
          "type": "object",
          "required": ["SoftwareID", "SoftwareName", "SoftwareGXP", "SoftwareType", "SoftwareScope"],
          "properties": {
            "SoftwareID": { "type": "string" },
            "SoftwareName": { "type": "string" },
            "SoftwareGXP": {
              "type": "string",
              "enum": ["GXP", "NGXP"]
            },
            "SoftwareCategory": {
              "type": "string",
              "description": "GAMP-Kategorie (z. B. Kat 1, 3, 4, 5)"
            },
            "SoftwareType": {
              "type": "string",
              "enum": [
                "Embedded / SPS-Software",
                "System- / Prozess-Software",
                "Enterprise-Software"
              ]
            },
            "SoftwareScope": {
              "type": "string",
              "enum": [
                "Equipment-spezifisch (SPS, Firmware)",
                "Prozess- / Linienbezogen (eBR, Auswertetools)",
                "Plant-weit / Enterprise (MES, ERP, LIMS, QMS)"
              ]
            }
          }
        }
      }
    },
    "MediumNode": {
      "type": "object",
      "required": ["id", "type", "properties"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "Medium" },
        "properties": {
          "type": "object",
          "required": ["MediumID", "MediumName", "MediumType", "MediumGXP", "MediumProductContact"],
          "properties": {
            "MediumID": { "type": "string" },
            "MediumName": { "type": "string" },
            "MediumType": {
              "type": "string",
              "enum": [
                "Process Gases & Compressed Air",
                "Water Systems",
                "HVAC / Cleanroom Air"
              ]
            },
            "MediumGXP": {
              "type": "string",
              "enum": ["GXP", "NGXP"]
            },
            "MediumProductContact": {
              "type": "string",
              "enum": ["Direct Impact", "Indirect Impact", "No Impact"]
            }
          }
        }
      }
    },
    "ProcessNode": {
      "type": "object",
      "required": ["id", "type", "properties"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "Prozess" },
        "properties": {
          "type": "object",
          "required": ["ProcessID", "ProcessName"],
          "properties": {
            "ProcessID": { "type": "string" },
            "ProcessName": { "type": "string" }
          }
        }
      }
    },
    "ProcessstepNode": {
      "type": "object",
      "required": ["id", "type", "properties"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "Prozessschritt" },
        "properties": {
          "type": "object",
          "required": ["ProcessstepID", "ProcessstepName"],
          "properties": {
            "ProcessstepID": { "type": "string" },
            "ProcessstepName": { "type": "string" }
          }
        }
      }
    },
    "MaterialNode": {
      "type": "object",
      "required": ["id", "type", "properties"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "Material" },
        "properties": {
          "type": "object",
          "required": ["MaterialID", "MaterialName", "MaterialType"],
          "properties": {
            "MaterialID": { "type": "string" },
            "MaterialName": { "type": "string" },
            "MaterialType": {
              "type": "string",
              "enum": [
                "Raw Material",
                "Component / Purchased Part",
                "Work in Progress (WIP) / Intermediate Product",
                "Sub-Assembly",
                "Finished Good",
                "Finished Medical Device"
              ]
            }
          }
        }
      }
    },
    "DocumentNode": {
      "type": "object",
      "required": ["id", "type", "properties"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "Dokument" },
        "properties": {
          "type": "object",
          "required": ["DocumentID", "DocumentName", "DocumentDMS", "DocumentType"],
          "properties": {
            "DocumentID": { "type": "string" },
            "DocumentName": { "type": "string" },
            "DocumentDMS": {
              "type": "string",
              "enum": ["SAP P1U", "DiaDoc"]
            },
            "DocumentType": {
              "type": "string",
              "enum": [
                "GSP",
                "Specification",
                "Batch Record",
                "Validation Documentation",
                "Work Instruction",
                "Form",
                "Template"
              ]
            }
          }
        }
      }
    },
    "ParameterNode": {
      "type": "object",
      "required": ["id", "type", "properties"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "Parameter" },
        "properties": {
          "type": "object",
          "required": ["ParameterID", "ParameterName", "ParameterClass"],
          "properties": {
            "ParameterID": { "type": "string" },
            "ParameterName": { "type": "string" },
            "ParameterClass": {
              "type": "string",
              "enum": ["CPP", "PP"]
            },
            "ParameterTargetValue": {
              "type": ["string", "number"]
            },
            "ParameterAcceptanceRange": {
              "type": "string"
            },
            "ParameterUnit": {
              "type": "string",
              "enum": [
                "°C", "bar", "sec", "min", "h",
                "rpm", "l", "g", "mg", "kg",
                "l/min", "%", "%rH"
              ]
            },
            "ParameterControlType": {
              "type": "string",
              "enum": ["Closed Loop", "Logged"]
            }
          }
        }
      }
    },
    "GraphEdge": {
      "type": "object",
      "required": ["from", "relation", "to"],
      "properties": {
        "from": {
          "type": "string",
          "description": "ID des Ausgangsknotens"
        },
        "relation": {
          "type": "string",
          "enum": [
            "Steht in",
            "führt aus",
            "ist Teil von",
            "steht in",
            "benötigt Input",
            "erzeugt Output",
            "führt zu Nachfolger (0:n)",
            "verwendet",
            "gehört zu",
            "unterstützt",
            "steuert",
            "definiert",
            "überwacht/regelt"
          ]
        },
        "to": {
          "type": "string",
          "description": "ID des Zielknotens"
        },
        "properties": {
          "type": "object",
          "description": "Kanten-Attribute",
          "properties": {
            "ProcessstepType": {
              "type": "string",
              "description": "Gilt für 'führt zu Nachfolger (0:n)'",
              "enum": [
                "Standard-Fertigungsschritt",
                "Gate / In-Process Control (IPC)",
                "Wartezeit / Haltezeit",
                "Schleifen-Knoten (Loop)"
              ]
            }
          }
        }
      }
    }
  }
}