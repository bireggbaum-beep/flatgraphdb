          },
          {
            "$ref": "#/$defs/Edge_Software_Unterstuetzt_Plant"
          },
          {
            "$ref": "#/$defs/Edge_Software_Unterstuetzt_Prozess"
          },
          {
            "$ref": "#/$defs/Edge_Software_Unterstuetzt_Prozessschritt"
          },
          {
            "$ref": "#/$defs/Edge_Software_Steuert_Equipment"
