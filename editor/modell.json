          },
          {
            "$ref": "#/$defs/Edge_Prozessschritt_BenoetigtInput_Material"
          },
          {
            "$ref": "#/$defs/Edge_Prozessschritt_ErzeugtOutput_Material"
          },
          {
            "$ref": "#/$defs/Edge_Prozessschritt_FuehrtZuNachfolger_Prozessschritt"
          },
          {
            "$ref": "#/$defs/Edge_Equipment_Verwendet_Medium"
          },
          {
            "$ref": "#/$defs/Edge_Dokument_GehoertZu_Equipment"
          },
          {
            "$ref": "#/$defs/Edge_Dokument_GehoertZu_Prozess"
          },
          {
